# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

NODE_ENV=development

# Supabase (Postgres + pgvector). Phase 0 헬스체크(app/api/health/route.ts)가 사용합니다.
# Supabase 프로젝트 설정 > API 에서 확인:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM 프로바이더 — AI-A(상황 분석) 실 연동. LLM_PROVIDER=claude일 때만
# 실제 Claude Haiku 4.5를 쓰고, 그 외(미설정 포함)에는 항상 mock으로 폴백한다.
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
