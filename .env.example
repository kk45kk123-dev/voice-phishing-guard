# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

NODE_ENV=development

# Supabase (Postgres + pgvector). Phase 0 헬스체크(app/api/health/route.ts)가 사용합니다.
# Supabase 프로젝트 설정 > API 에서 확인:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM 프로바이더 — Phase 3(AI-A)부터 필요. 프로바이더 선정은 DEV_SPEC.md §12 병행 트랙 3 참고.
# LLM_PROVIDER=
# LLM_API_KEY=
